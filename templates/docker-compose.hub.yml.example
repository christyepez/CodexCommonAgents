  worker:
    image: ${APP_WORKER_IMAGE:?APP_WORKER_IMAGE must reference an immutable registry tag or digest}
    build: null

  web:
    image: ${APP_WEB_IMAGE:?APP_WEB_IMAGE must reference an immutable registry tag or digest}
    build: null
